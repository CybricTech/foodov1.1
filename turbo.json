{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
        "NEXT_PUBLIC_MONNIFY_API_KEY",
        "NEXT_PUBLIC_MONNIFY_CONTRACT_CODE",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "PAYSTACK_SECRET_KEY",
        "MONNIFY_BASE_URL",
        "MONNIFY_API_KEY",
        "MONNIFY_SECRET_KEY",
        "MONNIFY_CONTRACT_CODE",
        "MONNIFY_WALLET_ACCOUNT",
        "GOOGLE_MAPS_API_KEY",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_APP_ENV",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_WEBHOOK_SECRET",
        "DOCUSEAL_API_URL",
        "DOCUSEAL_API_TOKEN",
        "DOCUSEAL_TEMPLATE_ID",
        "DOCUSEAL_MERCHANT_ROLE",
        "DOCUSEAL_KITCHYN_ROLE",
        "DOCUSEAL_KITCHYN_SIGNER_EMAIL",
        "DOCUSEAL_WEBHOOK_TOKEN"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
