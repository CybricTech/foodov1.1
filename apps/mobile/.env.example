# Kitchyn Merchant — Expo environment variables (EXPO_PUBLIC_* are bundled into
# the app and are NOT secret-safe; only public/anon values belong here).
#
# Copy to `.env` and fill in. The mobile app authenticates against the SAME
# Supabase project as the web app — use the same URL + anon key the web app
# uses (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY in apps/web).
#
# Do NOT put the Supabase service-role key or any private secret in this file.

# ── Supabase (required) ──────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# ── Web dashboard API base URL (required for status/dispatch actions) ─────────
# The ORIGIN of the deployed web app (apps/web). The mobile order-status and
# rider-dispatch actions POST to its /api/dashboard/orders/* routes with a
# Bearer access token. In production this is the Vercel URL; in local dev use
# your machine's LAN IP so a physical device can reach Next.js, e.g.
# http://192.168.1.20:3000  (NOT http://localhost:3000 — a phone can't reach that).
EXPO_PUBLIC_API_BASE_URL=https://your-web-app.vercel.app

# ── Observability (optional in Phase 0 — guarded so absence won't crash) ──────
# Sentry DSN for the kitchyn-qv org's mobile project (de.sentry.io).
EXPO_PUBLIC_SENTRY_DSN=
# PostHog (same project as web: EU cloud, project 191720).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── App environment ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
