    "@supabase/supabase-js": "^2.47.10",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.35",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
