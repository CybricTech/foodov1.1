{
  "name": "@foodo/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"mobile builds run via EAS (eas build) — see README\" && exit 0",
    "type-check": "tsc --noEmit",
