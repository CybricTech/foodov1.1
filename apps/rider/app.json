{
  "expo": {
    "name": "Foodo Rider",
    "slug": "foodo-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.foodo.rider",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Foodo Rider needs your location to broadcast your position during active deliveries.",
        "NSLocationWhenInUseUsageDescription": "Foodo Rider needs your location to find deliveries near you.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "ng.foodo.rider",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Foodo Rider needs your location during active deliveries.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F"
        }
      ]
    ],
    "scheme": "foodo-rider",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
