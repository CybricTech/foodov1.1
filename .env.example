# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Active payment gateway. "monnify" (default) or "paystack".
# Flip on Vercel + redeploy to switch gateways — no code change needed.
PAYMENT_PROVIDER=monnify

# Paystack (kept active as a fallback gateway — toggle via PAYMENT_PROVIDER)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Monnify
# Sandbox: https://sandbox.monnify.com  |  Production: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=MK_TEST_xxxxxxxxxx
MONNIFY_SECRET_KEY=your-monnify-client-secret
MONNIFY_CONTRACT_CODE=xxxxxxxxxx
# Optional — source wallet for disbursements. Leave blank to use the default.
MONNIFY_WALLET_ACCOUNT=
# Frontend SDK needs the API key + contract code (both safe to expose)
NEXT_PUBLIC_MONNIFY_API_KEY=MK_TEST_xxxxxxxxxx
NEXT_PUBLIC_MONNIFY_CONTRACT_CODE=xxxxxxxxxx

# Bolt Ride Booker (automated rider dispatch)
# Credentials are self-served from the "Ride Booker API" page in the Bolt
# Business portal (scroll to the bottom, click Renew).
# NOTE: if the secret contains a "$" it MUST be escaped as "\$" in apps/web/.env —
# Next.js (dotenv-expand) otherwise treats it as a variable and mangles the key.
BOLT_CLIENT_ID=your-bolt-client-id
BOLT_CLIENT_SECRET=your-bolt-client-secret
# Required only while platform_settings.bolt_environment = 'sandbox'. Obtained
# from POST /sandbox/control/create; every sandbox call carries it as ?uuid=.
BOLT_SANDBOX_UUID=
# Bearer token WE issue to Bolt for inbound ride-state webhooks. Generate a
# random string and give it to your Bolt rep along with the webhook URL.
BOLT_WEBHOOK_TOKEN=

# DocuSeal (Merchant Agreement e-signing)
# The lawyer-prepared Merchant Agreement PDF is uploaded ONCE into DocuSeal's
# template builder (fillable fields for Schedule 1 terms + Merchant/Kitchyn
# signature blocks) — DOCUSEAL_TEMPLATE_ID is that template's id.
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_API_TOKEN=your-docuseal-api-token
# Template built from docs/Kitchyn_Merchant_Agreement_TAGGED_docuseal.docx —
# the lawyer's blank template with {{field;role=...}} tags inserted. Rebuild with:
#   python3 docs/tag-agreement-docx.py \
#     docs/Kitchyn_Merchant_Agreement_TEMPLATE.docx \
#     docs/Kitchyn_Merchant_Agreement_TAGGED_docuseal.docx
#   docuseal templates create-docx --file docs/Kitchyn_Merchant_Agreement_TAGGED_docuseal.docx \
#     --name "Kitchyn Merchant Agreement"
# Current sandbox template id: 5201413 (25 fields, roles Merchant -> Kitchyn)
DOCUSEAL_TEMPLATE_ID=
# Must match the role names given to the two submitters in the DocuSeal template.
DOCUSEAL_MERCHANT_ROLE=Merchant
DOCUSEAL_KITCHYN_ROLE=Kitchyn
# Who countersigns on Kitchyn's behalf once a merchant completes signing.
DOCUSEAL_KITCHYN_SIGNER_EMAIL=
# Shared secret appended as ?token= on the webhook URL registered in DocuSeal's
# dashboard (Settings → Webhooks) — DocuSeal doesn't support custom headers, so
# the token travels in the URL query string instead. Generate a random string.
DOCUSEAL_WEBHOOK_TOKEN=

# Sendchamp (SMS — customer order notifications)
# Per-restaurant sender IDs are registered via the register-sms-sender Edge Function;
# until a restaurant's sender ID is approved by Sendchamp, sends use SENDCHAMP_DEFAULT_SENDER_ID.
# SENDCHAMP_API_KEY is also read by the Next.js app (for the delivery status check route).
SENDCHAMP_API_KEY=your-sendchamp-api-key
SENDCHAMP_DEFAULT_SENDER_ID=Foodo
SENDCHAMP_ROUTE=non_dnd

# Termii (WhatsApp + SMS — merchant new-order alerts only)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=Foodo

# Twilio (SMS fallback — merchant alerts only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@foodo.ng

# Google Maps (distance matrix for delivery fee calculation)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "development" | "staging" | "production" — controls Sentry sample rates + environment tagging
NEXT_PUBLIC_APP_ENV=development

# Sentry (error tracking + tracing)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@ingest.de.sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Client secret of the Sentry Internal Integration whose webhook points at
# /api/webhooks/sentry — used to verify incoming alert webhooks before
# forwarding them to Telegram (TELEGRAM_BOT_TOKEN + TELEGRAM_ALERTS_CHAT_ID).
SENTRY_WEBHOOK_SECRET=your-sentry-internal-integration-client-secret

# Telegram
# Shared bot token used for all Telegram notifications.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Chat ID for rider dispatch alerts (lib/telegram.ts).
TELEGRAM_CHAT_ID=your-rider-alerts-chat-id
# Chat ID for Sentry error alerts (api/webhooks/sentry) — separate group from rider alerts.
TELEGRAM_ALERTS_CHAT_ID=your-sentry-alerts-chat-id
